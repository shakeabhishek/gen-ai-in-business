# Copy this file to .env and fill in your key. .env is never committed.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Best free-tier model, used to read postings and score fit
GEMINI_MODEL=gemini-3.8-flash
# Used when the main model is overloaded (503)
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
