# Copy this file to .env and fill in your key. .env is never committed.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Best free-tier model, used to read postings and score fit
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when a model is out of free quota for the day or overloaded
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
